# ==============================================================================
# SKILLORA AI — Backend Environment Configuration
# ==============================================================================

# AI Provider Configuration: 
# Set to "deterministic" to use rule-based fallback mode (no API key required)
# Set to "gemini" or "openai" for actual LLM responses
AI_PROVIDER=deterministic

# Optional API Keys (Required if AI_PROVIDER is not "deterministic")
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OPENAI_API_KEY=

# Database Connection
DATABASE_URL=sqlite:///./skillora.db
